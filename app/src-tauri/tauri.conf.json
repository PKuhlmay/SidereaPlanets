{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Siderea Planets",
  "version": "1.0.0-rc.1",
  "identifier": "de.kuhlmay.siderea.planets",
  "build": {
    "beforeDevCommand": "pnpm gen:licenses --cached && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm gen:licenses && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Siderea Planets",
        "width": 1280,
        "height": 800,
        "minWidth": 1120,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../../LICENSE",
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" },
      "nsis": { "installMode": "both" }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/PKuhlmay/SidereaPlanets/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2ODk1NDJGMERDMEUzODQKUldTRTQ4QU5MMVNKcHBrWFZSYTU2b0dmYWJvS0g4aC9Vck5IKzhyQUkwUWxSMkdIR3FFSGxOYTMK"
    }
  }
}
